# ═══════════════════════════════════════════════════════════════════════
# ROUTE OPTIMIZATION API - ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual values

# ── Database (Supabase) ────────────────────────────────────────────────
# Get from: https://supabase.com -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=sb_secret_YOUR_SECRET_KEY_HERE

# ── Authentication ────────────────────────────────────────────────────
# JWT secret for token generation (use secure random string)
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256

# ── API Configuration ────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ── OSRM Service (Optional - for routing geometry) ──────────────────
# Leave empty to use public OSRM service (router.project-osrm.org)
OSRM_BASE_URL=https://router.project-osrm.org/route/v1/driving/

# ── Google Maps API (Optional) ──────────────────────────────────────
# Get from: https://console.cloud.google.com
GOOGLE_MAPS_API_KEY=

# ── Redis (Optional - for Celery task queue) ──────────────────────
# Format: redis://user:password@host:port/db
REDIS_URL=

# ── AWS S3 (Optional - for file storage) ──────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
